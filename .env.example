NEXT_PUBLIC_SUPABASE_URL=PASTE_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_PUBLISHABLE_KEY_HERE

# Server-only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=PASTE_GEMINI_API_KEY_HERE

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
# Public key is safe in the browser. Private key is server-only — never commit it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact URI sent with push requests. Not a secret.
# Do not use localhost. Apple rejects it with HTTP 403 BadJwtToken.
VAPID_SUBJECT=mailto:you@example.com

# Coaching reminders. Server-only. Never commit the real values.
# Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Long random string. Vercel sends it as Authorization: Bearer to the cron route.
CRON_SECRET=

# Supabase CLI auth: use `npm run supabase:login` (interactive).
# Do not put access tokens or database passwords in this file or the repo.
